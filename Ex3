import numpy as np

# Columns: Bedrooms, Area, Sale Price
house_data = np.array([
    [3, 1200, 200000],
    [5, 1800, 350000],
    [4, 1500, 280000],
    [6, 2200, 450000],
    [7, 2500, 550000],
    [2, 1000, 150000]
])

# Select houses with more than 4 bedrooms
selected_houses = house_data[house_data[:, 0] > 4]

# Calculate average sale price
average_price = np.mean(selected_houses[:, 2])

print("Houses with more than 4 bedrooms:")
print(selected_houses)

print("\nAverage sale price:", average_price)
