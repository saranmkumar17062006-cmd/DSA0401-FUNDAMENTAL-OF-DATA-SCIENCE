import matplotlib.pyplot as plt

months = [
    "Jan", "Feb", "Mar", "Apr", "May", "Jun",
    "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
]

temperature = [
    24, 26, 29, 32, 35, 34,
    33, 33, 32, 30, 27, 25
]

plt.plot(months, temperature, marker="o")

plt.title("Monthly Temperature")
plt.xlabel("Month")
plt.ylabel("Temperature (°C)")

plt.grid(True)
plt.show()
