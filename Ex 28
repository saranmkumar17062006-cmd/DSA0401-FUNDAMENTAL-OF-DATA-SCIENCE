import pandas as pd
from sklearn.tree import DecisionTreeRegressor, export_text

# Sample car dataset
data = pd.DataFrame({
    "Mileage": [15000, 25000, 35000, 45000, 55000,
                65000, 75000, 85000],
    "Age": [1, 2, 3, 4, 5, 6, 7, 8],
    "Engine": [2.0, 2.0, 1.8, 1.8, 1.6, 1.6, 1.4, 1.4],
    "Price": [22000, 20000, 18000, 16000, 14000,
              12000, 10000, 8000]
})

X = data[["Mileage", "Age", "Engine"]]
y = data["Price"]

# Create CART regression model
model = DecisionTreeRegressor(
    max_depth=4,
    random_state=42
)

model.fit(X, y)

# User input
mileage = float(input("Enter mileage: "))
age = float(input("Enter car age: "))
engine = float(input("Enter engine size: "))

new_car = pd.DataFrame({
    "Mileage": [mileage],
    "Age": [age],
    "Engine": [engine]
})

# Prediction
prediction = model.predict(new_car)

print("\nPredicted Car Price:",
      round(prediction[0], 2))

# Decision tree path
tree_rules = export_text(
    model,
    feature_names=list(X.columns)
)

print("\nDecision Tree Rules:")
print(tree_rules)
