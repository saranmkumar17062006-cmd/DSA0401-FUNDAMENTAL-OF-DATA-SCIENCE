import numpy as np

# 4x4 matrix: Math, Science, English, History
student_scores = np.array([
    [85, 78, 92, 80],
    [90, 88, 85, 75],
    [76, 82, 89, 91],
    [95, 90, 94, 88]
])

subjects = ["Math", "Science", "English", "History"]

# Calculate average for each subject
averages = np.mean(student_scores, axis=0)

print("Average score of each subject:")

for subject, avg in zip(subjects, averages):
    print(subject, ":", round(avg, 2))

# Find highest average
highest_index = np.argmax(averages)

print("\nSubject with highest average:")
print(subjects[highest_index])
print("Average:", round(averages[highest_index], 2))
