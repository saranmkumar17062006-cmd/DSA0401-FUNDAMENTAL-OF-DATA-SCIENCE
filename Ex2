import numpy as np

# 3x3 matrix containing product prices
product_prices = np.array([
    [100, 150, 200],
    [250, 300, 350],
    [400, 450, 500]
])

# Calculate average price
average_price = np.mean(product_prices)

print("Product Price Data:")
print(product_prices)

print("\nAverage price of all products:", average_price)
