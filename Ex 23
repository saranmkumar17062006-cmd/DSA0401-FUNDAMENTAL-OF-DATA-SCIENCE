import numpy as np
from scipy.stats import ttest_ind

# Conversion rate data
design_A = np.array([
    2.1, 2.5, 2.8, 2.4, 2.6,
    2.7, 2.3, 2.5, 2.9, 2.4
])

design_B = np.array([
    3.1, 3.4, 3.0, 3.5, 3.2,
    3.6, 3.3, 3.1, 3.5, 3.4
])

# Independent t-test
t_stat, p_value = ttest_ind(
    design_A,
    design_B
)

print("Design A Mean:",
      round(np.mean(design_A), 2))

print("Design B Mean:",
      round(np.mean(design_B), 2))

print("\nt-statistic:", round(t_stat, 4))
print("p-value:", round(p_value, 4))

alpha = 0.05

if p_value < alpha:
    print("\nThere is a statistically significant difference.")
else:
    print("\nThere is no statistically significant difference.")
