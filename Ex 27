import pandas as pd
import matplotlib.pyplot as plt

# Read CSV
data = pd.read_csv("soccer_players.csv")

# Top 5 players by goals
top_goals = data.sort_values(
    by="Goals",
    ascending=False
).head(5)

print("Top 5 Players by Goals:")
print(top_goals[["Name", "Goals"]])

# Top 5 players by salary
top_salary = data.sort_values(
    by="Salary",
    ascending=False
).head(5)

print("\nTop 5 Players by Salary:")
print(top_salary[["Name", "Salary"]])

# Average age
average_age = data["Age"].mean()

print("\nAverage Age:",
      round(average_age, 2))

# Players above average age
above_average = data[
    data["Age"] > average_age
]

print("\nPlayers above average age:")
print(above_average[["Name", "Age"]])

# Position distribution
position_count = data["Position"].value_counts()

print("\nPosition Distribution:")
print(position_count)

# Bar chart
position_count.plot(kind="bar")

plt.title("Players by Position")
plt.xlabel("Position")
plt.ylabel("Number of Players")

plt.show()
