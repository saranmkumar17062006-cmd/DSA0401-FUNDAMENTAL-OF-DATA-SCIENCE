import pandas as pd

property_data = pd.DataFrame({
    "Property_ID": [101, 102, 103, 104, 105],
    "Location": [
        "Chennai",
        "Chennai",
        "Bangalore",
        "Bangalore",
        "Chennai"
    ],
    "Bedrooms": [3, 5, 4, 6, 7],
    "Area": [1200, 1800, 1500, 2500, 3000],
    "Listing_Price": [
        3000000,
        5000000,
        4000000,
        7000000,
        8000000
    ]
})

# 1. Average listing price by location
average_price = property_data.groupby(
    "Location"
)["Listing_Price"].mean()

print("Average listing price by location:")
print(average_price)

# 2. Number of properties with more than 4 bedrooms
count_properties = (
    property_data["Bedrooms"] > 4
).sum()

print("\nNumber of properties with more than 4 bedrooms:",
      count_properties)

# 3. Property with largest area
largest_property = property_data.loc[
    property_data["Area"].idxmax()
]

print("\nProperty with largest area:")
print(largest_property)
