import pandas as pd
import re
import matplotlib.pyplot as plt
from collections import Counter

# Load CSV file
data = pd.read_csv("data.csv")

# Stop words
stop_words = {
    "the", "and", "is", "a", "an",
    "of", "to", "in", "for", "with"
}

# Combine feedback
text = " ".join(data["feedback"].astype(str))

# Convert to lowercase
text = text.lower()

# Remove punctuation
text = re.sub(r"[^a-z\s]", "", text)

# Split into words
words = text.split()

# Remove stop words
filtered_words = [
    word for word in words
    if word not in stop_words
]

# Calculate frequency
frequency = Counter(filtered_words)

# Get N from user
N = int(input("Enter the number of top words: "))

# Top N words
top_words = frequency.most_common(N)

print("\nTop", N, "most frequent words:")

for word, count in top_words:
    print(word, ":", count)

# Prepare data for plotting
words_list = [item[0] for item in top_words]
counts = [item[1] for item in top_words]

# Bar graph
plt.bar(words_list, counts)

plt.title("Top Frequent Words in Customer Feedback")
plt.xlabel("Words")
plt.ylabel("Frequency")

plt.xticks(rotation=45)

plt.tight_layout()
plt.show()
